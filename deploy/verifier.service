[Unit]
Description=National Identity Verification FastAPI Worker
After=network.target

[Service]
Type=simple
User=appuser
Group=appuser
WorkingDirectory=/opt/nid-portal/verifier
EnvironmentFile=/opt/nid-portal/verifier/.env
ExecStart=/opt/nid-portal/verifier/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001 --workers 2
Restart=always
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
